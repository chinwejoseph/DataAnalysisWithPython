        "#Handling missing data - for continuous attribute, replace values with mean\n",
        "#for categorical, replace values with the most frequent value\n",
        "#update the data types of the respective columns\n",
        "\n",
        "# Handle 'smoker' column\n",
        "is_smoker = df['smoker'].value_counts().idxmax()\n",
        "# Robustly convert 'smoker' to numeric, coercing any non-numeric values (including potential 'method' objects) to NaN\n",
        "df['smoker'] = pd.to_numeric(df['smoker'], errors='coerce')\n",
        "# Fill any NaN values (original '?' and coerced errors) with the most frequent smoker value\n",
        "df['smoker'] = df['smoker'].fillna(is_smoker)\n",
        "\n",
        "# Handle 'age' column\n",
        "# Robustly convert 'age' to numeric, coercing any non-numeric values to NaN\n",
        "df['age'] = pd.to_numeric(df['age'], errors='coerce')\n",
